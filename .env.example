# 复制为 .env 后填写；同名环境变量优先于 .env。

# 主 Agent 与内置游戏使用的模型：OpenAI 兼容接口
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_NAME=deepseek-flash
LLM_EXTRA_BODY_JSON={}
LLM_COMMAND=

# 使用本机 CLI 时，将上面的六项替换为对应示例，每项只保留一份。
# 安装并登录 CLI 后再启动游戏；下方语音和 Jev 配置仍然需要填写。

# Codex：执行 codex login 登录，codex login status 检查登录状态。
# LLM_PROVIDER=codex
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL_NAME=
# LLM_EXTRA_BODY_JSON={}
# LLM_COMMAND=codex

# Claude Code：执行 claude auth login 登录，claude auth status 检查登录状态。
# LLM_PROVIDER=claude_code
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL_NAME=
# LLM_EXTRA_BODY_JSON={}
# LLM_COMMAND=claude

# CLI 的 LLM_MODEL_NAME 留空时使用默认模型，填写时通过 --model 指定。
# LLM_COMMAND 只填写可执行文件名称或绝对路径，不包含参数。
# macOS/Linux 可用 command -v codex 或 command -v claude 查询路径。
# LLM_EXTRA_BODY_JSON 仅用于 OpenAI 兼容接口，CLI 必须保留 {}。

# 模型调用超时（秒）
LLM_TIMEOUT_SECONDS=180
# 预计画图耗时（秒），用于语音提示和进度条
DRAWING_ESTIMATE_SECONDS=60

# 游戏目录，默认读取项目目录中的 games.json
# GAME_CATALOG=/完整路径/games.json

# 语音识别和合成：百炼 API key 与业务空间地址需配套填写
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://llm-2lb3ys6gg99neqej.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_ASR_MODEL=qwen-audio-3.1-asr-flash-streaming
QWEN_TTS_MODEL=qwen-audio-3.1-tts-flash
# 音色需与 TTS 模型匹配
QWEN_TTS_VOICE=yuxiaoyun_v3.1

# Jev：判断指令、答案和闲聊
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
# 判定置信度阈值，范围 0.5～1.0
JEV_CONFIDENCE_THRESHOLD=0.65
