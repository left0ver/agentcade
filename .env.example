# 复制为 .env 后填写。同名环境变量优先于 .env。
# LLM 的接口地址、模型名称和 API key 需要配套填写。

# ---------- API key ----------

# 阿里云百炼，语音识别（ASR）和语音合成（TTS）共用
DASHSCOPE_API_KEY=
# Typesafe，Jev 用它判断玩家说的是指令、答案还是闲聊
TYPESAFE_API_KEY=

# ---------- LLM：闲聊和画图共用 ----------

# openai 表示 OpenAI 兼容接口，也可选择本机 claude_code / codex
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_NAME=deepseek-flash
# 每次模型调用的超时（秒）
LLM_TIMEOUT_SECONDS=180
# OpenAI 兼容接口的可选请求参数；按所用服务的文档填写
# 例如 DeepSeek：{"thinking":{"type":"enabled"},"reasoning_effort":"low"}
LLM_EXTRA_BODY_JSON={}
# 本机 CLI 命令路径；留空时根据 provider 使用 claude 或 codex
# CLI 使用已经登录的账号，无需 LLM_API_KEY；LLM_MODEL_NAME 留空则使用 CLI 默认模型
LLM_COMMAND=

# ---------- 画图 ----------

# 预计生成耗时（秒），用于语音播报和进度条，不影响实际生成
DRAWING_ESTIMATE_SECONDS=60

# ---------- 语音（Qwen-Audio） ----------

# 百炼业务空间的地址，必须是 HTTPS，按自己的空间填写。
# ASR/TTS 的 WebSocket 地址由它的主机名推出。
DASHSCOPE_BASE_URL=https://llm-2lb3ys6gg99neqej.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_ASR_MODEL=qwen-audio-3.1-asr-flash-streaming
QWEN_TTS_MODEL=qwen-audio-3.1-tts-flash
# 音色要和 TTS 模型同一系列，否则合成会失败
QWEN_TTS_VOICE=yuxiaoyun_v3.1

# ---------- 意图判断（Jev） ----------

JEV_MODEL=jev-latest
# 置信度低于该值时不采纳判定，请玩家再说一遍。范围 0.5 ~ 1.0
JEV_CONFIDENCE_THRESHOLD=0.65
