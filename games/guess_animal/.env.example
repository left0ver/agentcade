# 复制为本目录的 .env；配置仅供你画我猜使用。
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_NAME=deepseek-flash
LLM_EXTRA_BODY_JSON={}
LLM_COMMAND=
LLM_TIMEOUT_SECONDS=180

# provider 支持 openai、codex、claude_code。
# CLI 使用自己的登录凭据；模型名称留空使用 CLI 默认模型。
DRAWING_ESTIMATE_SECONDS=60
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_CONFIDENCE_THRESHOLD=0.65
