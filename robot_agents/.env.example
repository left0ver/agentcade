# 复制为本目录的 .env；配置仅供主 Agent 与公共语音使用。
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_NAME=deepseek-flash
LLM_EXTRA_BODY_JSON={}
LLM_COMMAND=
LLM_TIMEOUT_SECONDS=180

# provider 支持 openai、codex、claude_code。
# CLI 使用自己的登录凭据；LLM_MODEL_NAME 留空使用 CLI 默认模型。
# LLM_COMMAND 填写可执行文件名称或绝对路径，CLI 的 EXTRA_BODY 保持 {}。

# 相对路径以本 .env 所在目录为基准。
GAME_CATALOG=../games.json

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://llm-2lb3ys6gg99neqej.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_ASR_MODEL=qwen-audio-3.1-asr-flash-streaming
QWEN_TTS_MODEL=qwen-audio-3.1-tts-flash
QWEN_TTS_VOICE=yuxiaoyun_v3.1
