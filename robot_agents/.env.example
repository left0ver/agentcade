# 复制为本目录的 .env；主 Agent 独立读取语音、聊天和工具调用配置。

# 相对路径以本 .env 所在目录为基准。
GAME_CATALOG=../games.json

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_ASR_MODEL=qwen-audio-3.1-asr-flash-streaming
QWEN_TTS_MODEL=qwen-audio-3.1-tts-flash
QWEN_TTS_VOICE=yuxiaoyun_v3.1
SPEECH_TIMEOUT_SECONDS=90
ASR_SILENCE_MS=800
ASR_INPUT_GAIN=4

# 可观测性页面只监听本机：http://127.0.0.1:8790
# SDK 守护进程使用 8765 和 8767，这里需要选择其他端口。
OBSERVABILITY_PORT=8790

LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_NAME=deepseek-flash
LLM_TIMEOUT_SECONDS=90
LLM_EXTRA_BODY_JSON={"thinking":{"type":"disabled"},"max_tokens":1024}
