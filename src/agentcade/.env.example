# 主 Agent（小懒）：由 scripts/write_env_examples.py 根据 settings.yaml 生成，不要手改。
# 本地开发时复制为本目录的 .env；安装后的应用在设置页面里填写。

# 主要设置，没有默认值的必须填写。
# 阿里云百炼（DashScope）的 API Key，用于语音识别和语音合成
DASHSCOPE_API_KEY=
# 大模型的 API Key，用于聊天和选择游戏（OpenAI 兼容接口）
LLM_API_KEY=
# 大模型的接口地址
LLM_BASE_URL=https://api.deepseek.com
# 大模型的名称
LLM_MODEL_NAME=deepseek-flash

# 以下一般不用改。
# 大模型一次请求最长等待的秒数
LLM_TIMEOUT_SECONDS=90
# 附加到大模型请求里的参数，JSON 格式
LLM_EXTRA_BODY_JSON={}
# 百炼的接口地址，使用专属业务空间时改成对应的地址
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 语音识别模型
QWEN_ASR_MODEL=qwen-audio-3.1-asr-flash-streaming
# 语音合成模型
QWEN_TTS_MODEL=qwen-audio-3.1-tts-flash
# 语音合成的音色
QWEN_TTS_VOICE=yuxiaoyun_v3.1
# 一次语音合成最长等待的秒数
SPEECH_TIMEOUT_SECONDS=90
# 停顿多少毫秒算一句话说完，范围 200 到 6000
ASR_SILENCE_MS=800
# 麦克风音量放大倍数，范围 1 到 8
ASR_INPUT_GAIN=4
# 对话页面的本机端口，不能用 8765 和 8767
OBSERVABILITY_PORT=8790
# 远程游戏的注册文件，相对路径以应用目录为基准
GAME_CATALOG=games.json
