# 猜谜语的配置项，和 settings.yaml 一一对应。
# 本地调试时复制为本目录的 .env；部署到服务器时改成同名的环境变量。

# 主要设置，没有默认值的必须填写。
# 大模型的 API Key，用于主持游戏（OpenAI 兼容接口）
LLM_API_KEY=
# 大模型的接口地址
LLM_BASE_URL=https://api.deepseek.com
# 大模型的名称
LLM_MODEL_NAME=deepseek-flash

# 以下一般不用改。
# 大模型一次请求最长等待的秒数
LLM_TIMEOUT_SECONDS=180
# 附加到大模型请求里的参数，JSON 格式
LLM_EXTRA_BODY_JSON={}
